# Owner / migration credentials. Deploy to:
#   /etc/invoice-creator/admin.env    (owner root:root, mode 0600)
#
# Sourced ONLY by scripts/deploy.sh (for `npm run migrate`) and by manual
# `npm run seed` / `npm run create-admin` runs. It is never referenced by the
# running app and never added to the systemd service environment.

# invoice_owner: owns the schema, runs DDL, has CREATEROLE. Not a superuser.
DATABASE_ADMIN_URL=postgres://invoice_owner:REPLACE_WITH_OWNER_PW@localhost:5432/invoice_creator
