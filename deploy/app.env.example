# Production environment for the running app. Deploy to:
#   /etc/invoice-creator/app.env      (owner invoice:invoice, mode 0640)
#
# Consumed by:
#   - the systemd service  (EnvironmentFile=)
#   - scripts/deploy.sh    (sourced, for `npm run migrate`)
#
# This file must NOT contain DATABASE_ADMIN_URL — the running process has no
# business holding the owner/migration credentials. That lives in admin.env.

NODE_ENV=production
PORT=3000

# invoice_app_login: LOGIN role, NOT a superuser, NOT the schema owner,
# member of invoice_app + invoice_auth. Password set by the final ALTER ROLE
# in deploy/postgres-setup.sql.
DATABASE_URL=postgres://invoice_app_login:REPLACE_WITH_APP_PW@localhost:5432/invoice_creator

# Must be >= 32 chars. The app refuses to boot in production with the dev
# default or a short value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

JWT_EXPIRES_IN=30m

# AES-256-GCM key for secrets stored in the database (Fire.com credentials,
# webhook signing keys). Base64 of exactly 32 bytes. Required in production.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing ciphertext unreadable — re-enter the secrets.
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Login brute-force protection (per-process, in-memory).
LOGIN_MAX_PER_IDENTITY=8
LOGIN_MAX_PER_IP=30
LOGIN_WINDOW_MS=900000
