# Copy to .env for local development (`npm run dev`). Placeholders only — never
# commit a real .env (it is git-ignored). Tests ignore this file entirely
# (they run against an in-process PGlite database).

# --- Database -------------------------------------------------------------

# The RUNNING APP connects here. In production this MUST be `invoice_app_login`:
# a LOGIN role that is NOT a superuser and NOT the schema owner, member of
# `invoice_app` + `invoice_auth`. See docs/DEPLOYMENT.md.
#   Local dev with docker-compose: the app only ever SET LOCAL ROLEs to
#   invoice_app / invoice_auth, so pointing this at the dev superuser is fine:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_creator
DATABASE_URL=postgres://invoice_app_login:CHANGE_ME@localhost:5432/invoice_creator

# Used only by `npm run migrate` / `npm run seed`. An admin/owner role with
# CREATE on the schema + CREATEROLE. Never used at request time.
#   Local dev: DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/invoice_creator
DATABASE_ADMIN_URL=postgres://invoice_owner:CHANGE_ME@localhost:5432/invoice_creator

# --- Auth ---------------------------------------------------------------

# REQUIRED in production; the app refuses to start with the dev default or a
# value shorter than 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Access-token lifetime. Short-lived; logout / disable revoke via a watermark.
JWT_EXPIRES_IN=30m

# --- Login brute-force protection (single-process in-memory limiter) --------
LOGIN_MAX_PER_IDENTITY=8
LOGIN_MAX_PER_IP=30
LOGIN_WINDOW_MS=900000

PORT=3000
